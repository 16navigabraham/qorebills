# Copy to .env on the server (the Deploy workflow writes it from repository secrets).
# Never commit .env or paste these values in chat.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Public HTTPS address of this server; QoreX signing links point here
PUBLIC_URL=https://bills.example.com
PORT=8787

# The deployed BillAgentFactory (creates each user's account from their signed setup)
FACTORY_ADDRESS=0xF0385815a19009FBC01ba24773469c5e4e4e9b2D

# Optional: your numeric Telegram id, told when the agent's main key needs test QOR for gas
ADMIN_TELEGRAM_ID=

# Optional: how many accounts the demo creates at most (the agent pays everyone's gas)
# MAX_USERS=50

# Optional: understand free-form requests with Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# The agent's master key is created on first start in AGENT_KEY_FILE (mode 600) and
# never leaves the server. Key 0 creates accounts and funds the others; key n is user n's
# agent key, with its own ML-DSA-87 key and an EVM window scoped to that user's account.
# AGENT_KEY_FILE=data/agent.mnemonic
# STATE_FILE=data/state.json

# Testnet defaults
# QORE_EVM_RPC=https://evm-testnet.qore.host
# QORE_REST=https://api-testnet.qore.host
# QORE_RPC=https://rpc-testnet.qore.host
# EVM_CHAIN_ID=9800
# COSMOS_CHAIN_ID=qorechain-diana
# APPROVAL_MINUTES=30

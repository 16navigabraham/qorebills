# Copy to .env on the server. Never commit .env or paste these values in chat.

# The deployed BillAgentFactory (creates each owner's account from their signed setup)
FACTORY_ADDRESS=0x...

# Optional: the account is created through the setup page and remembered in STATE_FILE
# ACCOUNT_ADDRESS=0x...
# STATE_FILE=data/state.json

# The agent's own key is created on first start in AGENT_KEY_FILE (mode 600) and never
# leaves the server. The agent then asks you on Telegram for test QOR for gas, registers
# its ML-DSA-87 key and keeps a scoped EVM window open for the factory and your account.
# AGENT_KEY_FILE=data/agent.mnemonic

# From @BotFather, and your own numeric Telegram user id (e.g. from @userinfobot)
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Public HTTPS address of this server; approval links point here
PUBLIC_URL=https://bills.example.com
PORT=8787

# Optional: understand free-form requests with Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Testnet defaults
# QORE_EVM_RPC=https://evm-testnet.qore.host
# QORE_REST=https://api-testnet.qore.host
# QORE_RPC=https://rpc-testnet.qore.host
# EVM_CHAIN_ID=9800
# COSMOS_CHAIN_ID=qorechain-diana
# APPROVAL_MINUTES=30
